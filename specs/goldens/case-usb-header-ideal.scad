// usb-header: enclosure
// Generated by boardforge from the board file. Every number below is either a parameter you can
// edit and re-render, or derived from the board (regenerate the case to change those).
// Plain OpenSCAD, no libraries, so it opens in the Customizer and in web playgrounds.
// Coordinates are the board's own, y up. z = 0 is the outside of the case floor.

/* [Case] */
wall_thickness  = 2.4;   // [1.2:0.2:5] wall around the board
floor_thickness = 2;   // [1:0.2:5]
margin          = 0.2;   // [0:0.1:3] design gap between the board edge and the inside of the wall
lid_thickness   = 2;   // [1:0.2:5]
/* [Board fit] */
standoff_height = 3;   // [1:0.5:12] the board floats this far above the floor
headroom        = 1.5;   // [0.5:0.5:10] air above the tallest part
/* [Mounting] */
screw_size      = 2.2;   // [2:0.1:3.4] drill diameter (M2 = 2.2, M2.5 = 2.7, M3 = 3.2)
lip_height      = 2;   // [0:0.5:6] how far the lid's locating lip drops into the tray (0 = flat joint)
lip_thickness   = 1.2;   // [0.8:0.2:3] wall of that lip
/* [Print tolerances: ideal] */
// A printer does not make exact sizes. These are added to the drawn dimensions so real parts fit.
// Calibrate with a test print, then change these. All zero = exact CAD dimensions.
tol_slip         = 0;   // [0:0.05:1] extra room around the PCB so it drops in
tol_opening      = 0;   // [0:0.05:1] extra room around every connector opening
tol_screw_hole   = 0;   // [0:0.05:0.6] extra diameter for a screw to pass
tol_vertical_hole = 0;   // [0:0.05:0.5] holes printed upright close up, so they get more
tol_mating      = 0;   // [0:0.05:0.6] gap between the lid's lip and the tray
opening_clearance = tol_opening;
/* [Layout] */
part_gap        = 10;   // [0:1:40] space between the two printed parts

/* [Hidden] */
$fn = 48;
board_thickness = 1.6;   // from the board
tallest_top     = 8.5;   // tallest part on the top side
tray_height     = floor_thickness + standoff_height + board_thickness + tallest_top + headroom;
standoff_radius = screw_size / 2 + 2.2;
screw_hole      = screw_size + tol_screw_hole + tol_vertical_hole;   // = 2.2 at the current settings
gap             = margin + tol_slip;   // total board-to-wall gap: design gap + print gap
wall_offset     = gap + wall_thickness;

// the board outline, exactly as in the board file
module board_outline() {
  polygon([[-25, -15], [25, -15], [25, 15], [-25, 15]]);
}
module board_cutouts() {
  // none
}

// the cavity is the outline grown by the gap; the outer shell is the cavity grown by the wall
module cavity_2d() { offset(delta = gap) board_outline(); }
module shell_2d()  { offset(delta = wall_offset) board_outline(); }

module standoff(x, y) {
  translate([x, y, floor_thickness - 0.01])
    difference() {
      cylinder(h = standoff_height + 0.01, r = standoff_radius);
      translate([0, 0, -1]) cylinder(h = standoff_height + 2, d = screw_hole);
    }
}
module standoffs() {
  standoff(-22, 12);   // H1
  standoff(22, 12);   // H2
  standoff(-22, -12);   // H3
  standoff(22, -12);   // H4
}

module edge_openings() {
  // J1: USB-C, y+ wall
  translate([0 - (8.94 + 2 * opening_clearance) / 2, 15 + gap - 1, floor_thickness + standoff_height + board_thickness + 0 - opening_clearance]) cube([8.94 + 2 * opening_clearance, wall_offset + 2, 3.26 + 2 * opening_clearance]);
}

module case_bottom() {
  difference() {
    union() {
      difference() {
        linear_extrude(tray_height) shell_2d();
        translate([0, 0, floor_thickness]) linear_extrude(tray_height) cavity_2d();
      }
      standoffs();
    }
    edge_openings();
  }
}

module top_openings() {
  // none
}

// The lid locates on the tray with a lip that drops into the cavity. The lip is the cavity outline
// shrunk by the mating gap (so it slides in) and hollowed to lip_thickness (so it is a rim, not a plug).
module lid_lip() {
  if (lip_height > 0)
    difference() {
      linear_extrude(lid_thickness + lip_height) offset(delta = -tol_mating) cavity_2d();
      translate([0, 0, -1]) linear_extrude(lid_thickness + lip_height + 2) offset(delta = -(tol_mating + lip_thickness)) cavity_2d();
    }
}

// The lid is built upside down (flat face on the bed) with the lip pointing up, which is how it prints.
module case_lid() {
  difference() {
    union() {
      linear_extrude(lid_thickness) shell_2d();
      lid_lip();
    }
    translate([-22, 12, -1]) cylinder(h = lid_thickness + lip_height + 2, d = screw_hole);   // H1
    translate([22, 12, -1]) cylinder(h = lid_thickness + lip_height + 2, d = screw_hole);   // H2
    translate([-22, -12, -1]) cylinder(h = lid_thickness + lip_height + 2, d = screw_hole);   // H3
    translate([22, -12, -1]) cylinder(h = lid_thickness + lip_height + 2, d = screw_hole);   // H4
    top_openings();
  }
}

// ---- print both: the lid is laid beside the tray
case_bottom();
translate([50 + 2 * wall_offset + part_gap, 0, 0]) case_lid();
